{
  "plugin_name": "family-os-bb-inventory",
  "primary_skill_root": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory",
  "api_skill_root": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory-api",
  "skill_names": [
    "family-os-bb-inventory",
    "family-os-bb-inventory-api"
  ],
  "runtime_knowledge_root": "plugins-staging/family-os-bb-inventory/runtime",
  "relative_config_path": "plugins-staging/family-os-bb-inventory/runtime/telegram-runtime.json",
  "bridge_commands": {
    "bb_inventory_api": {
      "runner": "node",
      "path": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory-api/scripts/family_os_bb_inventory_api_client.mjs",
      "node_args": [
        "--use-system-ca"
      ]
    },
    "runtime_learning": {
      "runner": "node",
      "path": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/scripts/manage_runtime_learning.mjs"
    },
    "inventory_unit_preflight": {
      "runner": "node",
      "path": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/scripts/inventory_unit_preflight.mjs",
      "node_args": [
        "--use-system-ca"
      ]
    }
  },
  "scope": {
    "bb_log_types": [
      "feeding",
      "diaper",
      "sleep",
      "temperature",
      "note",
      "vaccination",
      "clinic_visit",
      "doctor_visit"
    ],
    "inventory_capabilities": [
      "snapshot",
      "low_stock",
      "restock",
      "consume",
      "set_level",
      "expiry_update",
      "new_item_bootstrap"
    ],
    "task_capabilities": [
      "append",
      "update",
      "query_open",
      "query_upcoming",
      "query_overdue"
    ]
  },
  "references": {
    "bb_log_templates": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/bb-log-templates.md",
    "inventory_flows": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/inventory-flows.md",
    "task_management": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/task-management.md",
    "unit_normalization": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/unit-normalization.md",
    "ambiguity_policy": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/ambiguity-policy.md",
    "self_enhance_policy": "plugins-staging/family-os-bb-inventory/skills/family-os-bb-inventory/references/self-enhance-policy.md"
  }
}
